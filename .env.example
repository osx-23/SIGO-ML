SIGO_ML_INTERNAL_TOKEN=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
SIGO_ML_MODEL_PATH=artifacts/asistencia.joblib
# URI PostgreSQL del usuario SIGO-ML con permiso SELECT solo en asistencia_registro.
# Copiar la URI del dialogo Connect de SIGO-TEST; NUNCA subir la URI real a Git.
SIGO_ML_DATABASE_URL=
SIGO_ML_DB_SSLMODE=verify-full
# Activar solo después de configurar la conexión anterior y validar en SIGO-TEST.
SIGO_ML_AUTO_TRAIN_ENABLED=false
SIGO_ML_MIN_MAE_GAIN=0
